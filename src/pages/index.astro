---
import { getSettings } from "./api/settings";
import Layout from "../layouts/Layout.astro";
import logoImg from "../assets/homepage-logo.webp";
import Image from "astro/components/Image.astro";
const navigation = ["How to order", "why to order", "Faqs", "samples"];
import Button from "@/components/Button/Button.astro";
import mainMenu from "@/assets/mainMenu";
const settingsData = await getSettings();
if (!settingsData) return Astro.redirect("/404");
---

<Layout settingsData={settingsData} slug="home">
    <div id="homepage-container" class="homepage-container">
        <Image
            class="homepage-logo-img"
            src={logoImg}
            alt="Antilogy Design & Screenprinting logo"
            aria-label="Antilogy Design"
        />
        <nav class="homepage-nav-container">
            {
                mainMenu.map((n) => {
                    return (
                        <a
                            href={n.url}
                            class="homepage-nav-button button-base button-base__active"
                        >
                            {n.label}
                        </a>
                    );
                })
            }
        </nav>
    </div>
</Layout>

<style>
    .homepage-container {
        background: var(--bg);
        border: 4px solid var(--for);
        margin: var(--gutter);
        max-width: 862px;
        padding: 24px 16px;
        text-align: center;
    }
    .homepage-logo-img {
        margin: 0 auto calc(var(--gutter) / 2);
    }

    @media (min-width: 950px) {
        .homepage-container {
            bottom: 88px;
            left: 50%;
            padding: calc(var(--gutter) * 1.5);
            position: absolute;
            transform: translateX(-50%);
            width: 100%;
        }
        .homepage-logo-img {
            max-width: 500px;
        }
    }
</style>
