---
import { getSettings } from './api/dynamodb/settings';
import Layout from '../layouts/Layout.astro';
import logoImg from "../assets/logo.png"
import Image from 'astro/components/Image.astro';
const navigation = ["How to order","why to order", "Faqs", "samples"];
import Button from '../components/Button.astro';

const settingsData = await getSettings();
if(!settingsData) return Astro.redirect("/404")

---

<Layout settingsData={settingsData} pageTitle='Antilogy Home Page'>
	<div class="mx-auto max-w-[862px] px-4 py-12 text-center">
		<Image class="mx-auto max-w-full" src={logoImg} alt="Antilogy Design & Screenprinting logo" aria-label="Antilogy Design" />
		<nav class="inline-block">
			{navigation.map(n=> {
				return <Button label={n} type="link" href='#' modClasses={["big"]} classes='text-center block mx-auto mb-4'
				
				
				/>
			})}
		</nav>

	</div>
</Layout>


<style>

</style>

