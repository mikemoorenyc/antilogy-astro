---
import { getSettings } from "./api/settings";
import { getImage,inferRemoteSize } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import type { ImageMetadata } from "astro";
import ImageViewer from "./_svelteComponents/ImageViewer.svelte";
import type {TImageUrls} from "@/types"
import { imageConfig } from "astro:assets";
import { actions } from 'astro:actions';
const settingsData = await getSettings();


if (!settingsData) return Astro.redirect("/404");

const {data,error} = await Astro.callAction(actions.settings.getSamplesSettings,"");
if(error) {
  console.log(error);
  return Astro.redirect("/404");
}
/*
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/samples/*.{jpeg,jpg,png,gif}",
);
if (Object.keys(images).length === 0) {
    return Astro.redirect("/404");
}
*/
const imageUrls: TImageUrls[] =  await Promise.all(data.sampleImages.map(async (i)=> {
  const {width,height}= await inferRemoteSize(i.url)
  let thumbnail = await getImage({
      src: i.url,
      height: 450,
      width: width * (450/height),
      layout: "constrained",
      inferSize:true
  });
  let full = await getImage({
      src: i.url,
      width: 2200,
      height:height * (2200/width),
      inferSize:true,
      layout: "constrained",
  });
  return {
    thumbnail: {
        src: thumbnail.src,
        srcSet: thumbnail.srcSet.attribute,
    },
    full: {
        src: full.src,
        srcSet: full.srcSet.attribute,
    }
  }
}))

