---

<Layout settingsData={settingsData} pageTitle={data.pageTitle} slug="samples">
    {data.pageIntro && <div set:html={data.pageIntro} class="dt-width-container copy-section pb-2">

    </div>}
    <ImageViewer client:load urls={imageUrls}/>
</Layout>
