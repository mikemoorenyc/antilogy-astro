---
import { actions } from 'astro:actions';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../_adminComponents/PageHeader.astro';
import SamplesForm from "./_samplesComponents/SamplesForm"


export const prerender = false;



const {data,error} = await Astro.callAction(actions.settings.getSamplesSettings,"");
if(error) {
  console.log(error)
  return Astro.redirect("/404");
}
data.sampleImages = data.sampleImages.map(s => {
  return {...s,...{loaded:true}}
})


---

<AdminLayout pageTitle={`${data.pageTitle}`}>
<PageHeader pageTitle={data.pageTitle} />
<SamplesForm  client:load {...data}/>


</AdminLayout>
