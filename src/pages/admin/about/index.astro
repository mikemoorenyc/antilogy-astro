---
import { getSession } from 'auth-astro/server';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../_adminComponents/PageHeader.astro';
import { getSettings } from '../../api/settings';
import type { Settings } from '@/pages/api/settings/_types';


export const prerender = false;
const session = await getSession(Astro.request);

if(!session) {
  return Astro.redirect('/login');
}
const settings : Settings = await getSettings() 
if(!settings) return Astro.redirect("/404");





---

<AdminLayout pageTitle={`FAQs - About - ${settings.siteTitle}`} settingsData={settings}>
<PageHeader pageTitle='About page' />

 

</AdminLayout>
