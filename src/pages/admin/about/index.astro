---
import { sessionCheck } from '@/pages/api/_lib';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../_adminComponents/PageHeader.astro';
import { getSettings } from '../../api/settings';
import type { Settings } from '@/pages/api/settings/_types';
import AboutForm from './_aboutComponents/AboutForm';
import type { only } from 'node:test';


export const prerender = false;

const settings : Settings = await getSettings() 
if(!settings) return Astro.redirect("/404");

const aboutText = settings?.aboutText || []





---

<AdminLayout pageTitle={`About - ${settings.siteTitle}`} settingsData={settings}>
  <PageHeader pageTitle='About page' /> 
  <AboutForm client:only="react" aboutText={aboutText}/>



 

</AdminLayout>
