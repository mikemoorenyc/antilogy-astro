---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from './_adminComponents/PageHeader.astro';
import ContactForm from './_adminComponents/ContactForm';
import { getContactForm } from '../api/contact/form';
import { actions } from 'astro:actions';
export const prerender = false

const {data,error} = await Astro.callAction(actions.settings.getContactSettings,"");
if(error) {
  console.log(String(error));
  return Astro.redirect("/404")
}


---


<AdminLayout pageTitle={`Contact form & info`}>
<PageHeader pageTitle='Contact form & info' />

  <ContactForm client:only="react" contactSettings={data}/>

</AdminLayout>
