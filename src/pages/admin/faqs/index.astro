---
import { actions } from 'astro:actions';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../_adminComponents/PageHeader.astro';
import FaqForm from "./_faqsComponents/FaqForm"


export const prerender = false;




const faqSection = await Astro.callAction(actions.settings.getFaqSettings,"");
if(faqSection.error) {
  console.log("couldn't get faq info");
  return Astro.redirect("/404");
}


---

<AdminLayout pageTitle={`FAQs`} >
<PageHeader pageTitle='FAQs' />
<FaqForm faqData={faqSection.data} client:only="react"/>


</AdminLayout>
