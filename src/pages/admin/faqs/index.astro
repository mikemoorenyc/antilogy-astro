---
import { actions } from 'astro:actions';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../_adminComponents/PageHeader.astro';
import FaqForm from "./_faqsComponents/FaqForm"


export const prerender = false;

const settingsR = await Astro.callAction(actions.settings.getMainSettings,"")
if(settingsR.error) return Astro.redirect("/404");



const settings = settingsR.data;
const faqSection = await Astro.callAction(actions.settings.getFaqSettings,"");
if(faqSection.error) {
  console.log("couldn't get faq info");
  return Astro.redirect("/404");
}


---

<AdminLayout pageTitle={`FAQs - Admin`} settingsData={settings}>
<PageHeader pageTitle='FAQs' />
<FaqForm faqData={faqSection.data} client:only="react"/>


</AdminLayout>
