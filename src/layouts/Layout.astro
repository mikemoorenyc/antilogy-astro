---
import type { Settings } from "@/pages/api/settings/_types";
import PageTitle from "@/components/PageTitle.astro";
import CloseSVG from "./CloseSVG.astro";
import MenuSVG from "./MenuSVG.astro";
interface Props {
    pageTitle?: string;
    meta?: string;
    children: any;
    settingsData: Settings;
    slug?: string;
}
import LayoutSkeleton from "./LayoutSkeleton.astro";
import { Image } from "astro:assets";

import mainMenu from "@/assets/mainMenu";
const { pageTitle, settingsData, slug } = Astro.props;
const social = ["instagram", "tiktok", "snapchat"];

//Get Image
const fileNames = Object.keys(
    import.meta.glob("../../public/bgs/*", { eager: true }),
).map((path) => path.split("/").at(-1)!);

const menu = [...[{url:"/",label:"Home"}],...mainMenu]
---

<LayoutSkeleton
    pageTitle={pageTitle}
    settingsData={settingsData}
    bodyCSS="flex min-h-screen flex-col text-[16px] md:text-[18px]"
>


    <div
        class="fixed inset-0 bg-cover bg-center"
        id="background-image"
        data-images={fileNames}
    >
    </div>
    {
        slug !== "home" && (
            <header id="header">
                <div class="header-inner">
                    <a class="header-logo hide-on-menu-open" href="/">
                        <Image
                            width={847}
                            height={164}
                            src={"/as-interior-logo.png"}
                            alt="Antilogy Design & Screenprinting"
                        />
                    </a>
                    <div class="header-dt-button-wrap">
                        <button
                            class="menu-opener"
                            data-open-text="Menu"
                            data-close-text="Close"
                            id="menu-open-button"
                        >
                            <span class="button-base menu-opener-inner">
                                <span role="none" class="menu-opener-icon menu-opener-button" aria-hidden=true>
                                    <span class=" close-icon hide-on-menu-close" >
                                        <CloseSVG />
                                    </span>
                                    <span class="menu-icon hide-on-menu-open" style="">
                                        <MenuSVG />
                                    </span>
                                </span>
                                <span class="menu-opener-text">Menu</span>
                            </span>
                        </button>
                    </div>
                </div>
                <div class="main-menu-nav-container">
                    <nav class="big-nav-list main-menu-nav homepage-nav-container">
                        {
                        menu.map(m=><a data-slug={m.slug} href={m.url} class={`button-base homepage-nav-button ${m.slug && slug == m.slug?"active":""}`}>{m.label}</a>)
                        }
                    </nav>
                </div>
            </header>
        )
    }
    <main
        class="relative flex-1 pb-12 hide-on-menu-open"
        id="main-container"
        data-current={slug || "default"}
    >
        {pageTitle && slug !== "home" && <PageTitle pageTitle={pageTitle} />}
        <slot />
    </main>

</LayoutSkeleton>

<style>
    #main-container:not([data-current="home"]) {
        background: var(--bg);
    }
    #main-container[data-current="home"]{
        align-items: center;
          display: flex;
          justify-content: center;
    }
    #header {
        position: relative;
        background: var(--bg);
        padding: calc(var(--gutter) * 1.5) var(--gutter);
        padding-bottom: calc(var(--gutter) * 2);
        z-index: 4;
    }
    body.menu-open #header {
        background:none ;
    }

    .header-logo {
        display: block;
        width: 125px;
    }
    .menu-opener {
        position: fixed;
          right: 0;
          top: 0;
          z-index: 81;
    }
    .menu-opener-inner {
      align-items: center;
      display: flex;
      margin: 20px var(--gutter) 0 0;
      font-weight: 400;
        padding: 4px 8px;
        text-transform: none;
    }
    .menu-opener-icon {
      margin-right: 6px;
    }
    .main-menu-nav-container {
        display:none;
        align-items: center;

        height: 100%;
        justify-content: center;
        left: 0;
        position: fixed;
        text-align: center;
        top: 0;
        width: 100%;
        z-index: 80;
    }
    body.menu-open .main-menu-nav-container {
        display:flex;
    }
    .homepage-nav-button.active {
        text-decoration: underline;
    }
    @media (min-width: 960px) {
        #main-container[data-current="home"]{
            display: block;
        }
        #header {
            padding-bottom: calc(var(--gutter) * 1.5);
        }
        .header-inner {
            margin: 0 auto;
            max-width: calc(1128px + var(--gutter) * 2);
            width: 100%;
        }
        .header-logo {
            position: relative;
            z-index: 82;
            width: 200px;
        }
        .header-dt-button-wrap {
            display: flex;
            justify-content: flex-end;
            left: 50%;
            max-width: calc(1128px + var(--gutter) * 2 + var(--gutter) * 2);
            padding: calc(var(--gutter) * 1.5) var(--gutter);
            position: fixed;
            top: 0;
            transform: translateX(-50%);
            width: 100%;
            z-index: 81;
        }
        .menu-opener-inner {
            font-size: 14px;
            font-weight: 700;
            padding: 6px 16px;
            position: relative;
            text-decoration: none;
            text-transform: uppercase;
            margin: 0
        }
        .menu-opener {
          position: static;
        }
    }
</style>

<script>
    const bg = document.getElementById("background-image");
    const files: string[] = (bg?.dataset.images || "").split(",");

    const menuBtn = document.getElementById("menu-open-button");
    let menuOpen = false
    const bod = document.body
    if(menuBtn) {
      menuBtn.addEventListener("click",function(e) {
        e.preventDefault()
        let btnText = !menuOpen?menuBtn.getAttribute("data-close-text"):menuBtn.getAttribute("data-open-text")
        let textSpan = menuBtn.querySelector(".menu-opener-text")

        if(textSpan) {
          textSpan.innerHTML = btnText||""
        }
        let removeClass = !menuOpen ? "menu-close":"menu-open"
        let addClass=!menuOpen ? "menu-open":"menu-close"
        bod.classList.remove(removeClass)
        bod.classList.add(addClass)
        menuOpen = !menuOpen

      })
    }

    if (files.length > 0 && bg) {
        const randomIndex = Math.floor(Math.random() * files.length);
        bg.style.backgroundImage = `url(/bgs/${files[randomIndex]})` || "";
    }
</script>
