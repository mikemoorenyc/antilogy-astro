---

import "../globalCSS/index.css";
import { inferRemoteSize ,getImage} from "astro:assets";
import type { TMainSettings } from "@/actions/settings/schema";
interface Props {
    pageTitle?: string;
    bodyCSS?: string;
    metaDescription?: string;
    settingsData:TMainSettings
}
const { pageTitle, bodyCSS, metaDescription,settingsData } = Astro.props;



const settings = settingsData;

if (!settings) return Astro.redirect("/404");

const desc = metaDescription || settings.siteDescription;
let processedSvgUrl:string=""
if(settings.siteFaviconSVG) {

   let {width,height,format} = await inferRemoteSize(settings.siteFaviconSVG);
   if(width&&height&&format=="svg") {
     let {src} = await getImage({
         src:settings.siteFaviconSVG,
         height,
         width
     });
     processedSvgUrl = src;
   }
}
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {
            desc && (
                <meta
                    name="description"
                    content={desc}
                    itemprop="description"
                />
            )
        }
        <link
            rel="icon"
            href={processedSvgUrl || "/favicon.svg"}
            type="image/svg+xml"
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bakbak+One&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <title>
            {`${pageTitle ? pageTitle + " - " : ""}${settings.siteTitle}${settings.siteTagline? ` - ${settings.siteTagline}`:""}`}
        </title>
    </head>
    <body class={(bodyCSS || "") + " menu-close"}>
        <slot />
        <div id="modal-container"></div>
    </body>
</html>
