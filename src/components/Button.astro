---

import { type IButton } from "../../types"


interface Props extends IButton {
  slot?:any
}
//type IFooBar = IButton & Props 
const cProps  = Astro.props ;

const {type,label,style,icon,classes,href,actionId, modClasses=[]}  = cProps


const mc = modClasses.join(" ")
const Element = type == "link" ? "a" : "button"

---
<Element style={typeof style == "string"?style:undefined} id={actionId||undefined}href={href} class={`button-component ${classes||""} ${mc}`}>
<slot name="icon">

</slot>
<span>{label}</span>
</Element>


