---
import type { Icon } from "./types"
interface Props extends Icon{};

const {size,fill,icon} = Astro.props


const setSize = size || 16
const setFill = fill || 'currentColor'

---

<svg style={`width:${setSize}px; height:${setSize}px; fill:${setFill}`}>
  <use  href={`/remixicon.symbol.svg#${icon}`}></use>
</svg>